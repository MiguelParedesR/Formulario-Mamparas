{
  "name": "formulario-mamparas",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "build:css:legacy": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.css --minify",
    "dev:css:legacy": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.css --watch"
  },
  "dependencies": {
    "docxtemplater": "^3.67.5",
    "exceljs": "^4.4.0",
    "pizzip": "^3.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
